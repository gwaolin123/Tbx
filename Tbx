local function loadMainScript()
    loginGui:Destroy()
    
    -- MAIN SCRIPT START
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera
    local VirtualUser = game:GetService("VirtualUser")

    local espEnabled = true
    local autoBlockEnabled = false
    local autoDodgeEnabled = false
    local autoDashEnabled = false
    local instantUltEnabled = false

    -- FPS BOOSTER
    local function boostFPS()
        pcall(function()
            game:GetService("Lighting").ShadowSoftness = 0
            game:GetService("Lighting").Technology = Enum.Technology.Compatibility
            settings().Rendering.QualityLevel = 1
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Decal") or v:IsA("Texture") then
                    v.Enabled = false
                end
            end
        end)
    end
    boostFPS()

    -- GUI
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TSBGUI"
    screenGui.Parent = game:GetService("CoreGui")
    screenGui.ResetOnSpawn = false

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 200, 0, 280)
    mainFrame.Position = UDim2.new(0.1, 0, 0.3, 0)
    mainFrame.BackgroundColor3 = Color3.new(0, 0, 0)
    mainFrame.BackgroundTransparency = 0.3
    mainFrame.BorderSizePixel = 2
    mainFrame.BorderColor3 = Color3.new(1, 0.5, 0)
    mainFrame.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Text = "TSB | astro"
    title.TextColor3 = Color3.new(1, 1, 0)
    title.BackgroundTransparency = 1
    title.Parent = mainFrame

    local hideBtn = Instance.new("TextButton")
    hideBtn.Size = UDim2.new(0, 50, 0, 25)
    hideBtn.Position = UDim2.new(0.7, 0, 0, 2)
    hideBtn.Text = "━"
    hideBtn.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
    hideBtn.Parent = mainFrame

    local floatingCircle = Instance.new("TextButton")
    floatingCircle.Size = UDim2.new(0, 55, 0, 55)
    floatingCircle.Position = UDim2.new(0.02, 0, 0.85, 0)
    floatingCircle.BackgroundColor3 = Color3.new(1, 0.5, 0)
    floatingCircle.BackgroundTransparency = 0.2
    floatingCircle.Text = "A"
    floatingCircle.TextColor3 = Color3.new(1, 1, 1)
    floatingCircle.TextSize = 28
    floatingCircle.TextScaled = true
    floatingCircle.Parent = screenGui
    floatingCircle.Visible = false

    local function createButton(name, y, text)
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.new(0, 170, 0, 35)
        btn.Position = UDim2.new(0, 15, 0, y)
        btn.Text = text
        btn.BackgroundColor3 = Color3.new(0.6, 0.2, 0.2)
        btn.Parent = mainFrame
        return btn
    end

    local espBtn = createButton("EspBtn", 35, "ESP: ON")
    local blockBtn = createButton("BlockBtn", 75, "AUTO BLOCK: OFF")
    local dodgeBtn = createButton("DodgeBtn", 115, "AUTO DODGE: OFF")
    local dashBtn = createButton("DashBtn", 155, "AUTO DASH: OFF")
    local ultBtn = createButton("UltBtn", 195, "INSTANT ULT: OFF")

    espBtn.BackgroundColor3 = Color3.new(0.2, 0.8, 0.2)

    -- ESP
    local espLabels = {}
    local function updateESP()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not espLabels[player] then
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(0, 120, 0, 22)
                    label.BackgroundColor3 = Color3.new(0, 0, 0)
                    label.BackgroundTransparency = 0.5
                    label.BorderSizePixel = 1
                    label.Parent = screenGui
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 13
                    espLabels[player] = label
                end
                local label = espLabels[player]
                if espEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local rootPos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                    if onScreen then
                        label.TextColor3 = Color3.new(1, 0, 0)
                        label.Text = player.Name
                        label.Position = UDim2.new(0, rootPos.X - 60, 0, rootPos.Y - 40)
                        label.Visible = true
                    else
                        label.Visible = false
                    end
                else
                    if label then label.Visible = false end
                end
            end
        end
    end

    -- DETECT ENEMY ATTACK (animation based)
    local function isEnemyAttacking(player)
        local char = player.Character
        if not char then return false end
        -- Check if enemy raised arm (attack animation)
        local rightArm = char:FindFirstChild("RightArm")
        local leftArm = char:FindFirstChild("LeftArm")
        if rightArm and rightArm.Velocity.Y > 30 then
            return true
        end
        if leftArm and leftArm.Velocity.Y > 30 then
            return true
        end
        -- Check if enemy is close and moving fast toward you
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and myHrp then
            local dist = (hrp.Position - myHrp.Position).Magnitude
            local speed = hrp.Velocity.Magnitude
            if dist < 12 and speed > 20 then
                return true
            end
        end
        return false
    end

    -- AUTO BLOCK
    local function autoBlock()
        if not autoBlockEnabled then return end
        pcall(function()
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and isEnemyAttacking(player) then
                    VirtualUser:Button1Down(Vector2.new(0,0))
                    wait(0.01)
                    VirtualUser:Button1Up(Vector2.new(0,0))
                    break
                end
            end
        end)
    end

    -- REAL AUTO DODGE (only when enemy attacks)
    local function autoDodge()
        if not autoDodgeEnabled then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and isEnemyAttacking(player) then
                    local enemyHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if enemyHrp then
                        -- Dodge backward from enemy
                        local direction = (hrp.Position - enemyHrp.Position).Unit
                        hrp.CFrame = hrp.CFrame + direction * 15
                        -- Press dodge button (F or Q)
                        VirtualUser:Button2Down(Vector2.new(0,0))
                        wait(0.05)
                        VirtualUser:Button2Up(Vector2.new(0,0))
                    end
                    break
                end
            end
        end)
    end

    -- AUTO DASH TO ENEMY (when not attacking)
    local function autoDash()
        if not autoDashEnabled then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local nearestDist = 18
            local nearestEnemy = nil
            
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyHrp = player.Character.HumanoidRootPart
                    local dist = (enemyHrp.Position - hrp.Position).Magnitude
                    if dist < nearestDist and dist > 6 then
                        nearestDist = dist
                        nearestEnemy = player
                    end
                end
            end
            
            if nearestEnemy then
                local enemyHrp = nearestEnemy.Character.HumanoidRootPart
                local direction = (enemyHrp.Position - hrp.Position).Unit
                hrp.CFrame = hrp.CFrame + direction * 12
                VirtualUser:Button2Down(Vector2.new(0,0))
                wait(0.05)
                VirtualUser:Button2Up(Vector2.new(0,0))
            end
        end)
    end

    -- WORKING INSTANT ULTIMATE
    local function instantUlt()
        if not instantUltEnabled then return end
        pcall(function()
            -- Try to find and activate ultimate
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, tool in pairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and (tool.Name:lower():find("ult") or tool.Name:lower():find("special")) then
                        LocalPlayer.Character.Humanoid:EquipTool(tool)
                        tool:Activate()
                    end
                end
            end
            -- Check character for ultimate tool
            if LocalPlayer.Character then
                for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
                    if tool:IsA("Tool") and (tool.Name:lower():find("ult") or tool.Name:lower():find("special")) then
                        tool:Activate()
                    end
                end
            end
            -- Alternative: Fire remote for ultimate
            local replicated = game:GetService("ReplicatedStorage")
            if replicated:FindFirstChild("Remotes") then
                local ultRemote = replicated.Remotes:FindFirstChild("ActivateUltimate")
                if ultRemote then
                    ultRemote:FireServer()
                end
            end
        end)
    end

    -- MAIN LOOP
    RunService.RenderStepped:Connect(function()
        updateESP()
        autoBlock()
        autoDodge()
        autoDash()
        if instantUltEnabled then
            instantUlt()
        end
    end)

    -- BUTTONS
    espBtn.Activated:Connect(function()
        espEnabled = not espEnabled
        espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"
        espBtn.BackgroundColor3 = espEnabled and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.6, 0.2, 0.2)
        if not espEnabled then
            for _, label in pairs(espLabels) do
                if label then label.Visible = false end
            end
        end
    end)

    blockBtn.Activated:Connect(function()
        autoBlockEnabled = not autoBlockEnabled
        blockBtn.Text = autoBlockEnabled and "AUTO BLOCK: ON" or "AUTO BLOCK: OFF"
        blockBtn.BackgroundColor3 = autoBlockEnabled and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.6, 0.2, 0.2)
    end)

    dodgeBtn.Activated:Connect(function()
        autoDodgeEnabled = not autoDodgeEnabled
        dodgeBtn.Text = autoDodgeEnabled and "AUTO DODGE: ON" or "AUTO DODGE: OFF"
        dodgeBtn.BackgroundColor3 = autoDodgeEnabled and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.6, 0.2, 0.2)
    end)

    dashBtn.Activated:Connect(function()
        autoDashEnabled = not autoDashEnabled
        dashBtn.Text = autoDashEnabled and "AUTO DASH: ON" or "AUTO DASH: OFF"
        dashBtn.BackgroundColor3 = autoDashEnabled and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.6, 0.2, 0.2)
    end)

    ultBtn.Activated:Connect(function()
        instantUltEnabled = not instantUltEnabled
        ultBtn.Text = instantUltEnabled and "INSTANT ULT: ON" or "INSTANT ULT: OFF"
        ultBtn.BackgroundColor3 = instantUltEnabled and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.6, 0.2, 0.2)
    end)

    -- HIDE/SHOW
    hideBtn.Activated:Connect(function()
        mainFrame.Visible = false
        floatingCircle.Visible = true
    end)

    floatingCircle.Activated:Connect(function()
        mainFrame.Visible = true
        floatingCircle.Visible = false
    end)

    -- DRAG
    local dragStart, frameStart, isDragging
    mainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStart = input.Position
            frameStart = mainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    local circleDragStart, circleStartPos, isCircleDragging
    floatingCircle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isCircleDragging = true
            circleDragStart = input.Position
            circleStartPos = floatingCircle.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isCircleDragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - circleDragStart
            floatingCircle.Position = UDim2.new(circleStartPos.X.Scale, circleStartPos.X.Offset + delta.X, circleStartPos.Y.Scale, circleStartPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            isCircleDragging = false
        end
    end)

    -- CLEANUP
    Players.PlayerRemoving:Connect(function(player)
        if espLabels[player] then
            espLabels[player]:Destroy()
            espLabels[player] = nil
        end
    end)

    print("TSB script loaded. Real Dodge only triggers during enemy attacks. Ultimate now works.")
end

-- PASSWORD CHECK
local function checkPassword()
    if passwordBox.Text == "astro" then
        loadMainScript()
    else
        errorText.Text = "Incorrect password"
    end
end

submitBtn.MouseButton1Click:Connect(checkPassword)
passwordBox.FocusLost:Connect(checkPassword)
